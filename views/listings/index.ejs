<% layout("/layouts/boilerplate") %>

<style>
    .filters-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        margin-top: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    #filters {
        display: flex;
        align-items: center;
        gap: 2rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
        flex: 1 1 auto;
        min-width: 0;
        padding: 0.5rem 0;
    }

    #filters::-webkit-scrollbar {
        display: none; /* Chrome, Safari */
    }

    .filter {
        text-align: center;
        opacity: 0.7;
        transition: opacity 0.2s ease, transform 0.2s ease;
        flex: 0 0 auto;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .filter:hover {
        opacity: 1;
        transform: translateY(-2px);
    }

    .filter i {
        font-size: 1.35rem;
        margin-bottom: 0.35rem;
        display: block;
    }

    .filter p {
        font-size: 0.75rem;
        font-weight: 500;
        margin: 0;
        white-space: nowrap;
    }

    .tax-toggle {
        border: 1px solid #dee2e6;
        border-radius: 2rem;
        padding: 0.65rem 1.25rem;
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        background-color: #fff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    }

    .tax-toggle .form-check-label {
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
    }

    .tax-info {
        display: none;
    }

    @media (max-width: 768px) {
        .filters-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        #filters {
            width: 100%;
        }

        .tax-toggle {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="filters-wrapper">
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-chess-rook"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-paw"></i></div>
            <p>Jungle</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </div>
    </div>

    <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse m-0 d-flex align-items-center gap-2">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-4">
    <% for(let listing of allListings) { %>
    <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card h-100 listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b><br>
                        <span class="text-muted"><%= listing.location %>, <%= listing.country %></span><br>
                        <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> <span class="text-muted">/ night</span>
                        <i class="tax-info text-muted">&nbsp; &nbsp;+18% GST</i>
                    </p>
                </div>
            </div>
        </a>
    </div>
    <% } %>
</div>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        const taxInfo = document.getElementsByClassName("tax-info");
        for(let info of taxInfo) {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        }
    });
</script>
