<% layout("/layouts/boilerplate") %>

<%
  const categoriesList = [
    { id: "all", label: "All", icon: "fa-solid fa-border-all" },
    { id: "trending", label: "Trending", icon: "fa-solid fa-fire" },
    { id: "iconic", label: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
    { id: "mountains", label: "Mountains", icon: "fa-solid fa-mountain" },
    { id: "castles", label: "Castles", icon: "fa-solid fa-chess-rook" },
    { id: "pools", label: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
    { id: "camping", label: "Camping", icon: "fa-solid fa-campground" },
    { id: "farms", label: "Farms", icon: "fa-solid fa-cow" },
    { id: "arctic", label: "Arctic", icon: "fa-solid fa-snowflake" },
    { id: "jungle", label: "Jungle", icon: "fa-solid fa-paw" },
    { id: "beach", label: "Beach", icon: "fa-solid fa-umbrella-beach" },
  ];
  const currentCategory = (typeof category !== "undefined" && category) ? category.toLowerCase() : "all";

  function getPaginationUrl(p) {
    const params = new URLSearchParams();
    if (typeof q !== 'undefined' && q) params.set('q', q);
    if (typeof category !== 'undefined' && category && category !== 'all') params.set('category', category);
    if (typeof minPrice !== 'undefined' && minPrice) params.set('minPrice', minPrice);
    if (typeof maxPrice !== 'undefined' && maxPrice) params.set('maxPrice', maxPrice);
    if (typeof sort !== 'undefined' && sort && sort !== 'recommended') params.set('sort', sort);
    if (typeof selectedAmenities !== 'undefined' && selectedAmenities && selectedAmenities.length > 0) {
      selectedAmenities.forEach(a => params.append('amenities[]', a));
    }
    params.set('page', p);
    return '/listings?' + params.toString();
  }
%>

<!-- Filters, Tax Switch, and Advanced Filters Button -->
<div class="filters-wrapper">
    <div id="filters">
        <% for(let cat of categoriesList) { %>
            <% 
               const isSelected = (currentCategory === cat.id) || (currentCategory === "all" && cat.id === "all");
               let targetUrl = "/listings";
               const params = new URLSearchParams();
               if (cat.id !== "all" && !isSelected) {
                 params.set("category", cat.id);
               }
               if (typeof q !== "undefined" && q) params.set("q", q);
               if (typeof minPrice !== "undefined" && minPrice) params.set("minPrice", minPrice);
               if (typeof maxPrice !== "undefined" && maxPrice) params.set("maxPrice", maxPrice);
               if (typeof sort !== "undefined" && sort && sort !== "recommended") params.set("sort", sort);
               if (typeof selectedAmenities !== "undefined" && selectedAmenities && selectedAmenities.length > 0) {
                 selectedAmenities.forEach(a => params.append("amenities[]", a));
               }
               const qs = params.toString();
               if (qs) targetUrl += "?" + qs;
            %>
            <a href="<%= targetUrl %>" class="filter <%= isSelected ? 'active-filter' : '' %>">
                <div class="icon-container"><i class="<%= cat.icon %>"></i></div>
                <p><%= cat.label %></p>
            </a>
        <% } %>
    </div>

    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        <!-- Display total after taxes toggle -->
        <div class="tax-toggle" id="taxToggleBox">
            <label class="tax-toggle-label me-2" for="switchCheckDefault">Display total after taxes</label>
            <div class="form-check form-switch m-0 p-0 d-inline-flex align-items-center">
                <input class="form-check-input m-0" type="checkbox" role="switch" id="switchCheckDefault">
            </div>
        </div>

        <!-- Filters Button -->
        <button type="button" class="filter-modal-btn" data-bs-toggle="modal" data-bs-target="#filtersModal">
            <i class="fa-solid fa-sliders me-2"></i>
            <span>Filters</span>
            <% if (typeof activeFilterCount !== "undefined" && activeFilterCount > 0) { %>
                <span class="badge rounded-pill bg-danger ms-1" style="font-size: 0.68rem;"><%= activeFilterCount %></span>
            <% } %>
        </button>

        <!-- Map Toggle Button in Bar -->
        <button type="button" class="filter-modal-btn map-bar-toggle-btn" id="mapBarToggleBtn" title="Toggle Map View">
            <i class="fa-solid fa-map me-1 text-danger"></i>
            <span>Show map</span>
        </button>
    </div>
</div>

<!-- Listings Container: Maximum 3 listings per row on desktop -->
<%
  const listingsMapData = (allListings || [])
    .filter(l => l.geometry && Array.isArray(l.geometry.coordinates) && l.geometry.coordinates.length === 2 && !isNaN(l.geometry.coordinates[0]) && !isNaN(l.geometry.coordinates[1]))
    .map(l => {
      let rCount = (l.reviews && l.reviews.length) || 0;
      let aRating = 0;
      if (rCount > 0) {
        let sum = 0, count = 0;
        for (let r of l.reviews) {
          const val = (r && typeof r.rating === 'number') ? r.rating : (typeof r === 'number' ? r : null);
          if (val !== null) { sum += val; count++; }
        }
        if (count > 0) aRating = Number((sum / count).toFixed(1));
      }
      return {
        id: l._id.toString(),
        title: l.title,
        price: l.price || 0,
        location: l.location || "",
        country: l.country || "",
        image: l.image ? l.image.url : (l.images && l.images.length > 0 ? l.images[0].url : ""),
        avgRating: aRating,
        reviewCount: rCount,
        coordinates: l.geometry.coordinates
      };
    });
%>

<% if (allListings.length === 0) { %>
    <div class="col-12 text-center py-5 my-4">
        <div class="mb-3">
            <i class="fa-solid fa-house-circle-xmark text-muted" style="font-size: 3.5rem;"></i>
        </div>
        <h4 class="fw-bold">No stays found</h4>
        <p class="text-muted">
            <% if (currentCategory && currentCategory !== "all") { %>
                There are currently no stays matching your filters in the <b><%= currentCategory %></b> category.
            <% } else if (typeof q !== "undefined" && q) { %>
                No stays match your search for "<b><%= q %></b>".
            <% } else { %>
                No stays match your active filter criteria.
            <% } %>
        </p>
        <a href="/listings" class="btn btn-outline-dark px-4 py-2 mt-2">
            <i class="fa-solid fa-rotate-left me-2"></i>Clear Filters
        </a>
    </div>
<% } else { %>
    <div class="explore-split-wrapper" id="exploreSplitWrapper">
        <div class="row g-4" id="exploreSplitRow">
            <!-- Listings Column -->
            <div class="col-12" id="listingsCol">
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5" id="listingsGrid">
        <% 
           const userWishlist = (currentUser && currentUser.wishlist) ? currentUser.wishlist.map(id => id.toString()) : [];
        %>
        <% for(let listing of allListings) { %>
            <% 
               const basePrice = listing.price || 0;
               const taxPrice = Math.round(basePrice * 1.18);
               const isWishlisted = userWishlist.includes(listing._id.toString());

               let reviewCount = (listing.reviews && listing.reviews.length) || 0;
               let avgRating = 0;
               if (reviewCount > 0) {
                 let sum = 0, count = 0;
                 for (let r of listing.reviews) {
                   const ratingVal = (r && typeof r.rating === 'number') ? r.rating : (typeof r === 'number' ? r : null);
                   if (ratingVal !== null) {
                     sum += ratingVal;
                     count++;
                   }
                 }
                 if (count > 0) avgRating = (sum / count).toFixed(1);
               }
               const isGuestFavorite = (avgRating >= 4.5 && reviewCount >= 2);
            %>
            <div class="col listing-col-item" data-listing-id="<%= listing._id %>">
                <div class="card h-100 listing-card position-relative">
                    <!-- Wishlist Heart Button -->
                    <button 
                        type="button" 
                        class="wishlist-heart-btn <%= isWishlisted ? 'active' : '' %>" 
                        data-listing-id="<%= listing._id %>"
                        title="<%= isWishlisted ? 'Remove from wishlist' : 'Save to wishlist' %>"
                        aria-label="Wishlist toggle"
                    >
                        <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
                    </button>

                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="position-relative">
                            <img src="<%= listing.image ? listing.image.url : '' %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                            <% if (isGuestFavorite) { %>
                                <span class="card-badge guest-favorite-badge">Guest favorite</span>
                            <% } else if (listing.category && listing.category !== "trending") { %>
                                <span class="card-badge category-pill-badge text-capitalize"><%= listing.category %></span>
                            <% } %>
                        </div>
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                <b class="text-truncate flex-grow-1 me-2" style="font-size: 1.02rem;"><%= listing.title %></b>
                                <span class="card-rating d-inline-flex align-items-center flex-shrink-0">
                                    <i class="fa-solid fa-star me-1 text-danger"></i>
                                    <% if (avgRating > 0) { %>
                                        <span class="fw-semibold text-dark"><%= avgRating %></span>
                                        <span class="text-muted ms-1 small">(<%= reviewCount %>)</span>
                                    <% } else { %>
                                        <span class="text-muted small">New</span>
                                    <% } %>
                                </span>
                            </div>

                            <span class="text-muted d-block small mb-1"><%= listing.location %>, <%= listing.country %></span>
                            
                            <!-- Normal Price -->
                            <span class="base-price">
                                <span class="fw-semibold fs-6">&#8377; <%= basePrice ? basePrice.toLocaleString("en-IN") : "N/A" %></span> 
                                <span class="text-muted small">/ night</span>
                            </span>
                            
                            <!-- Price with 18% GST -->
                            <span class="tax-price d-none">
                                <span class="fw-semibold fs-6 text-dark">&#8377; <%= taxPrice ? taxPrice.toLocaleString("en-IN") : "N/A" %></span> 
                                <span class="text-muted small">total after taxes</span>
                                <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.68rem;">incl. 18% GST</span>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        <% } %>
                </div>

                <!-- Load More Stays Button (Infinite Scroll / AJAX) -->
                <% if (typeof totalPages !== 'undefined' && currentPage < totalPages) { %>
                    <div class="text-center my-4" id="loadMoreSection">
                        <button type="button" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold load-more-btn" id="loadMoreBtn" data-next-page="<%= currentPage + 1 %>" data-total-pages="<%= totalPages %>">
                            <span id="loadMoreBtnText">Load more stays</span>
                            <span class="spinner-border spinner-border-sm ms-2 d-none" id="loadMoreSpinner" role="status" aria-hidden="true"></span>
                        </button>
                    </div>
                <% } %>

                <!-- Numbered Pagination Bar -->
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <nav aria-label="Page navigation" class="d-flex flex-column align-items-center my-4 pagination-nav">
                        <ul class="pagination pagination-sm justify-content-center flex-wrap gap-1 mb-2">
                            <!-- Prev Button -->
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link page-link-pill px-3" href="<%= getPaginationUrl(currentPage - 1) %>">
                                    <i class="fa-solid fa-chevron-left me-1"></i> Prev
                                </a>
                            </li>

                            <!-- Page Numbers -->
                            <% for (let p = 1; p <= totalPages; p++) { %>
                                <li class="page-item <%= currentPage === p ? 'active' : '' %>">
                                    <a class="page-link page-link-num" href="<%= getPaginationUrl(p) %>"><%= p %></a>
                                </li>
                            <% } %>

                            <!-- Next Button -->
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link page-link-pill px-3" href="<%= getPaginationUrl(currentPage + 1) %>">
                                    Next <i class="fa-solid fa-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                        <small class="text-muted">
                            Showing <%= ((currentPage - 1) * limit) + 1 %> – <%= Math.min(currentPage * limit, totalListings) %> of <%= totalListings %> stays
                        </small>
                    </nav>
                <% } %>
            </div>

            <!-- Sticky Explore Map Column -->
            <div class="col-12 col-lg-5 d-none" id="mapCol">
                <div class="explore-map-sticky">
                    <div id="exploreMap" class="explore-map-canvas"></div>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- Floating Map Pill Button -->
<% if (allListings && allListings.length > 0) { %>
    <div class="floating-map-container" id="floatingMapContainer">
        <button type="button" class="floating-map-pill" id="floatingMapBtn" aria-label="Show map">
            <i class="fa-solid fa-map me-2"></i><span>Show map</span>
        </button>
    </div>
<% } %>

<!-- Advanced Filters Modal -->
<div class="modal fade" id="filtersModal" tabindex="-1" aria-labelledby="filtersModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-4 border-0 shadow">
      
      <div class="modal-header px-4 py-3 border-bottom">
        <h5 class="modal-title fw-bold" id="filtersModalLabel">Filters</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form action="/listings" method="GET" id="advancedFiltersForm">
        <!-- Preserve search query & category if present -->
        <% if (typeof q !== "undefined" && q) { %>
          <input type="hidden" name="q" value="<%= q %>">
        <% } %>
        <% if (typeof category !== "undefined" && category && category !== "all") { %>
          <input type="hidden" name="category" value="<%= category %>">
        <% } %>

        <div class="modal-body p-4">
          
          <!-- Price Range Section -->
          <div class="mb-4">
            <div class="filter-section-title">Price range (per night)</div>
            <div class="price-range-box mb-3">
              <div class="row g-3 align-items-center">
                <div class="col-6">
                  <label for="minPriceInput" class="form-label text-muted small fw-semibold">Minimum</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">&#8377;</span>
                    <input type="number" id="minPriceInput" name="minPrice" class="form-control" placeholder="500" min="0" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
                  </div>
                </div>
                <div class="col-6">
                  <label for="maxPriceInput" class="form-label text-muted small fw-semibold">Maximum</label>
                  <div class="input-group input-group-sm">
                    <span class="input-group-text">&#8377;</span>
                    <input type="number" id="maxPriceInput" name="maxPrice" class="form-control" placeholder="50000" min="0" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
                  </div>
                </div>
              </div>
              <div class="mt-3">
                <label for="priceSlider" class="form-label text-muted small d-flex justify-content-between">
                  <span>Price Slider</span>
                  <span class="fw-semibold text-dark">&#8377; <span id="priceSliderVal"><%= typeof maxPrice !== 'undefined' && maxPrice ? Number(maxPrice).toLocaleString("en-IN") : '25,000' %></span></span>
                </label>
                <input type="range" class="form-range price-slider-track" id="priceSlider" min="500" max="50000" step="500" value="<%= typeof maxPrice !== 'undefined' && maxPrice ? maxPrice : '25000' %>">
              </div>
            </div>
          </div>

          <hr class="my-4">

          <!-- Sort Order Section -->
          <div class="mb-4">
            <div class="filter-section-title">Sort by</div>
            <div class="row g-2">
              <div class="col-6 col-md-3">
                <input type="radio" class="btn-check" name="sort" id="sortRecommended" value="recommended" <%= (typeof sort === 'undefined' || sort === '' || sort === 'recommended') ? 'checked' : '' %>>
                <label class="btn btn-outline-dark btn-sm w-100 rounded-pill py-2" for="sortRecommended">Recommended</label>
              </div>
              <div class="col-6 col-md-3">
                <input type="radio" class="btn-check" name="sort" id="sortPriceLow" value="price_asc" <%= (typeof sort !== 'undefined' && sort === 'price_asc') ? 'checked' : '' %>>
                <label class="btn btn-outline-dark btn-sm w-100 rounded-pill py-2" for="sortPriceLow">Price: Low to High</label>
              </div>
              <div class="col-6 col-md-3">
                <input type="radio" class="btn-check" name="sort" id="sortPriceHigh" value="price_desc" <%= (typeof sort !== 'undefined' && sort === 'price_desc') ? 'checked' : '' %>>
                <label class="btn btn-outline-dark btn-sm w-100 rounded-pill py-2" for="sortPriceHigh">Price: High to Low</label>
              </div>
              <div class="col-6 col-md-3">
                <input type="radio" class="btn-check" name="sort" id="sortRating" value="rating_desc" <%= (typeof sort !== 'undefined' && sort === 'rating_desc') ? 'checked' : '' %>>
                <label class="btn btn-outline-dark btn-sm w-100 rounded-pill py-2" for="sortRating">Top Rated</label>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <!-- Amenities Section -->
          <div class="mb-3">
            <div class="filter-section-title">Amenities</div>
            <% 
               const amenitiesList = [
                 { id: "wifi", label: "Fast WiFi", icon: "fa-solid fa-wifi" },
                 { id: "pool", label: "Pool", icon: "fa-solid fa-person-swimming" },
                 { id: "ac", label: "Air conditioning", icon: "fa-solid fa-snowflake" },
                 { id: "parking", label: "Free parking", icon: "fa-solid fa-square-parking" },
                 { id: "kitchen", label: "Kitchen", icon: "fa-solid fa-kitchen-set" },
                 { id: "tv", label: "TV", icon: "fa-solid fa-tv" },
                 { id: "workspace", label: "Dedicated workspace", icon: "fa-solid fa-laptop" },
                 { id: "pets", label: "Pet friendly", icon: "fa-solid fa-paw" },
               ];
               const currentAmenities = (typeof selectedAmenities !== 'undefined' && selectedAmenities) ? selectedAmenities : [];
            %>
            <div class="row row-cols-1 row-cols-sm-2 g-2">
              <% for(let item of amenitiesList) { %>
                <div class="col">
                  <label class="amenity-checkbox-card" for="amenity-<%= item.id %>">
                    <input type="checkbox" id="amenity-<%= item.id %>" name="amenities[]" value="<%= item.id %>" <%= currentAmenities.includes(item.id) ? 'checked' : '' %>>
                    <i class="<%= item.icon %>"></i>
                    <span class="amenity-label"><%= item.label %></span>
                  </label>
                </div>
              <% } %>
            </div>
          </div>

        </div>

        <div class="modal-footer px-4 py-3 border-top d-flex justify-content-between">
          <a href="/listings<%= typeof category !== 'undefined' && category && category !== 'all' ? '?category=' + category : '' %>" class="btn btn-link text-dark text-decoration-underline p-0 fw-semibold">
            Clear all
          </a>
          <button type="submit" class="btn btn-dark add-btn rounded-pill px-4 py-2">
            Apply Filters
          </button>
        </div>

      </form>

    </div>
  </div>
</div>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    const taxToggleBox = document.getElementById("taxToggleBox");

    function updateTaxPrices() {
        const basePrices = document.querySelectorAll(".base-price");
        const taxPrices = document.querySelectorAll(".tax-price");
        const isChecked = taxSwitch.checked;

        basePrices.forEach(el => el.classList.toggle("d-none", isChecked));
        taxPrices.forEach(el => el.classList.toggle("d-none", !isChecked));
    }

    if (taxSwitch && taxToggleBox) {
      taxSwitch.addEventListener("change", updateTaxPrices);

      // Clicking anywhere on the pill container toggles the switch
      taxToggleBox.addEventListener("click", (e) => {
          if (e.target !== taxSwitch) {
              taxSwitch.checked = !taxSwitch.checked;
              updateTaxPrices();
          }
      });
    }

    // Wishlist Toggle Handler
    document.querySelectorAll(".wishlist-heart-btn").forEach((btn) => {
        btn.addEventListener("click", async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const listingId = btn.getAttribute("data-listing-id");
            const icon = btn.querySelector("i");

            try {
                const res = await fetch(`/listings/${listingId}/wishlist`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    }
                });

                if (res.status === 401) {
                    window.location.href = "/login";
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    if (data.isSaved) {
                        btn.classList.add("active");
                        icon.classList.remove("fa-regular");
                        icon.classList.add("fa-solid");
                        btn.title = "Remove from wishlist";
                    } else {
                        btn.classList.remove("active");
                        icon.classList.remove("fa-solid");
                        icon.classList.add("fa-regular");
                        btn.title = "Save to wishlist";
                    }

                    // Update navbar badge if present
                    const badge = document.getElementById("navWishlistBadge");
                    if (badge) {
                        badge.textContent = data.count;
                        badge.classList.toggle("d-none", data.count === 0);
                    }
                }
            } catch (err) {
                console.error("Wishlist toggle error:", err);
            }
        });
    });

    // Price Slider Sync
    const priceSlider = document.getElementById("priceSlider");
    const maxPriceInput = document.getElementById("maxPriceInput");
    const priceSliderVal = document.getElementById("priceSliderVal");

    if (priceSlider && maxPriceInput) {
      priceSlider.addEventListener("input", function() {
        maxPriceInput.value = this.value;
        if (priceSliderVal) priceSliderVal.textContent = Number(this.value).toLocaleString("en-IN");
      });
      maxPriceInput.addEventListener("input", function() {
        if (this.value) {
          priceSlider.value = this.value;
          if (priceSliderVal) priceSliderVal.textContent = Number(this.value).toLocaleString("en-IN");
        }
      });
    }

    // Load More Stays AJAX Handler
    const loadMoreBtn = document.getElementById("loadMoreBtn");
    const loadMoreSpinner = document.getElementById("loadMoreSpinner");
    const loadMoreBtnText = document.getElementById("loadMoreBtnText");
    const loadMoreSection = document.getElementById("loadMoreSection");
    const listingsGrid = document.getElementById("listingsGrid");

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", async () => {
        let nextPage = parseInt(loadMoreBtn.getAttribute("data-next-page"), 10);
        const totalPages = parseInt(loadMoreBtn.getAttribute("data-total-pages"), 10);

        loadMoreBtn.disabled = true;
        if (loadMoreSpinner) loadMoreSpinner.classList.remove("d-none");
        if (loadMoreBtnText) loadMoreBtnText.textContent = "Loading stays...";

        try {
          const urlParams = new URLSearchParams(window.location.search);
          urlParams.set("page", nextPage);
          urlParams.set("format", "json");

          const res = await fetch(`/listings?${urlParams.toString()}`, {
            headers: { "Accept": "application/json" }
          });
          const data = await res.json();

          if (data.success && data.listings && data.listings.length > 0) {
            const isTaxChecked = document.getElementById("switchCheckDefault")?.checked;

            data.listings.forEach((listing) => {
              const basePrice = listing.price || 0;
              const taxPrice = Math.round(basePrice * 1.18);
              const reviewCount = (listing.reviews && listing.reviews.length) || 0;
              let avgRating = 0;
              if (reviewCount > 0) {
                let sum = 0, count = 0;
                for (let r of listing.reviews) {
                  const val = (r && typeof r.rating === 'number') ? r.rating : (typeof r === 'number' ? r : null);
                  if (val !== null) { sum += val; count++; }
                }
                if (count > 0) avgRating = (sum / count).toFixed(1);
              }
              const isGuestFavorite = (avgRating >= 4.5 && reviewCount >= 2);

              const cardCol = document.createElement("div");
              cardCol.className = "col listing-col-item";
              cardCol.setAttribute("data-listing-id", listing._id);

              cardCol.innerHTML = `
                <div class="card h-100 listing-card position-relative">
                  <button type="button" class="wishlist-heart-btn" data-listing-id="${listing._id}" title="Save to wishlist" aria-label="Wishlist toggle">
                    <i class="fa-regular fa-heart"></i>
                  </button>
                  <a href="/listings/${listing._id}" class="listing-link">
                    <div class="position-relative">
                      <img src="${listing.image ? listing.image.url : ''}" class="card-img-top" alt="${listing.title}" loading="lazy">
                      ${isGuestFavorite ? '<span class="card-badge guest-favorite-badge">Guest favorite</span>' : (listing.category && listing.category !== 'trending' ? `<span class="card-badge category-pill-badge text-capitalize">${listing.category}</span>` : '')}
                    </div>
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-baseline mb-1">
                        <b class="text-truncate flex-grow-1 me-2" style="font-size: 1.02rem;">${listing.title}</b>
                        <span class="card-rating d-inline-flex align-items-center flex-shrink-0">
                          <i class="fa-solid fa-star me-1 text-danger"></i>
                          ${avgRating > 0 ? `<span class="fw-semibold text-dark">${avgRating}</span><span class="text-muted ms-1 small">(${reviewCount})</span>` : '<span class="text-muted small">New</span>'}
                        </span>
                      </div>
                      <span class="text-muted d-block small mb-1">${listing.location}, ${listing.country}</span>
                      <span class="base-price ${isTaxChecked ? 'd-none' : ''}">
                        <span class="fw-semibold fs-6">&#8377; ${basePrice.toLocaleString("en-IN")}</span> 
                        <span class="text-muted small">/ night</span>
                      </span>
                      <span class="tax-price ${isTaxChecked ? '' : 'd-none'}">
                        <span class="fw-semibold fs-6 text-dark">&#8377; ${taxPrice.toLocaleString("en-IN")}</span> 
                        <span class="text-muted small">total after taxes</span>
                        <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.68rem;">incl. 18% GST</span>
                      </span>
                    </div>
                  </a>
                </div>
              `;
              listingsGrid.appendChild(cardCol);
            });

            // Update page counter
            nextPage++;
            loadMoreBtn.setAttribute("data-next-page", nextPage);

            if (nextPage > totalPages) {
              if (loadMoreSection) loadMoreSection.remove();
            } else {
              loadMoreBtn.disabled = false;
              if (loadMoreSpinner) loadMoreSpinner.classList.add("d-none");
              if (loadMoreBtnText) loadMoreBtnText.textContent = "Load more stays";
            }
          } else {
            if (loadMoreSection) loadMoreSection.remove();
          }
        } catch (err) {
          console.error("Failed to load more stays:", err);
          loadMoreBtn.disabled = false;
          if (loadMoreSpinner) loadMoreSpinner.classList.add("d-none");
          if (loadMoreBtnText) loadMoreBtnText.textContent = "Load more stays";
        }
      });
    }
</script>

