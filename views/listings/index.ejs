<% layout("/layouts/boilerplate") %>

<%
  const categoriesList = [
    { id: "all", label: "All", icon: "fa-solid fa-border-all" },
    { id: "trending", label: "Trending", icon: "fa-solid fa-fire" },
    { id: "iconic", label: "Iconic Cities", icon: "fa-solid fa-mountain-city" },
    { id: "mountains", label: "Mountains", icon: "fa-solid fa-mountain" },
    { id: "castles", label: "Castles", icon: "fa-solid fa-chess-rook" },
    { id: "pools", label: "Amazing Pools", icon: "fa-solid fa-person-swimming" },
    { id: "camping", label: "Camping", icon: "fa-solid fa-campground" },
    { id: "farms", label: "Farms", icon: "fa-solid fa-cow" },
    { id: "arctic", label: "Arctic", icon: "fa-solid fa-snowflake" },
    { id: "jungle", label: "Jungle", icon: "fa-solid fa-paw" },
    { id: "beach", label: "Beach", icon: "fa-solid fa-umbrella-beach" },
  ];
  const currentCategory = (typeof category !== "undefined" && category) ? category.toLowerCase() : "all";
%>

<style>
    .filters-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        margin-top: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    #filters {
        display: flex;
        align-items: center;
        gap: 2rem;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none; /* Firefox */
        flex: 1 1 auto;
        min-width: 0;
        padding: 0.5rem 0;
    }

    #filters::-webkit-scrollbar {
        display: none; /* Chrome, Safari */
    }

    .filter {
        text-align: center;
        opacity: 0.65;
        transition: opacity 0.2s ease, transform 0.2s ease, color 0.2s ease;
        flex: 0 0 auto;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        border-bottom: 2px solid transparent;
        padding-bottom: 0.25rem;
    }

    .filter:hover {
        opacity: 1;
        transform: translateY(-2px);
        color: #fe424d;
    }

    .filter.active-filter {
        opacity: 1;
        color: #fe424d;
        border-bottom: 2.5px solid #fe424d;
    }

    .filter.active-filter p {
        font-weight: 700;
        color: #fe424d;
    }

    .filter i {
        font-size: 1.35rem;
        margin-bottom: 0.35rem;
        display: block;
    }

    .filter p {
        font-size: 0.75rem;
        font-weight: 500;
        margin: 0;
        white-space: nowrap;
    }

    .tax-toggle {
        border: 1px solid #dee2e6;
        border-radius: 2rem;
        padding: 0.65rem 1.25rem;
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        background-color: #fff;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    }

    .tax-toggle .form-check-label {
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
    }

    .tax-info {
        display: none;
    }

    @media (max-width: 768px) {
        .filters-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        #filters {
            width: 100%;
        }

        .tax-toggle {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="filters-wrapper">
    <div id="filters">
        <% for(let cat of categoriesList) { %>
            <% 
               const isSelected = (currentCategory === cat.id) || (currentCategory === "all" && cat.id === "all");
               let targetUrl = "/listings";
               if (cat.id !== "all" && !isSelected) {
                 targetUrl = "/listings?category=" + cat.id;
                 if (typeof q !== "undefined" && q) {
                   targetUrl += "&q=" + encodeURIComponent(q);
                 }
               } else if (typeof q !== "undefined" && q) {
                 targetUrl = "/listings?q=" + encodeURIComponent(q);
               }
            %>
            <a href="<%= targetUrl %>" class="filter <%= isSelected ? 'active-filter' : '' %>">
                <div><i class="<%= cat.icon %>"></i></div>
                <p><%= cat.label %></p>
            </a>
        <% } %>
    </div>

    <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse m-0 d-flex align-items-center gap-2">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<% if (allListings.length === 0) { %>
    <div class="col-12 text-center py-5 my-4">
        <div class="mb-3">
            <i class="fa-solid fa-house-circle-xmark text-muted" style="font-size: 3.5rem;"></i>
        </div>
        <h4 class="fw-bold">No stays found</h4>
        <p class="text-muted">
            <% if (currentCategory && currentCategory !== "all") { %>
                There are currently no stays in the <b><%= currentCategory %></b> category.
            <% } else if (typeof q !== "undefined" && q) { %>
                No stays match your search for "<b><%= q %></b>".
            <% } else { %>
                No stays are currently available.
            <% } %>
        </p>
        <a href="/listings" class="btn btn-outline-dark px-4 py-2 mt-2">
            <i class="fa-solid fa-rotate-left me-2"></i>Clear Filters
        </a>
    </div>
<% } else { %>
    <div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-4">
        <% for(let listing of allListings) { %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card h-100 listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b><br>
                            <span class="text-muted"><%= listing.location %>, <%= listing.country %></span><br>
                            <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span> <span class="text-muted">/ night</span>
                            <i class="tax-info text-muted">&nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        </div>
        <% } %>
    </div>
<% } %>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        const taxInfo = document.getElementsByClassName("tax-info");
        for(let info of taxInfo) {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        }
    });
</script>
