<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <h3 class="mb-4 fw-bold">Edit your Listing</h3>
    
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required/>
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>
      
      <!-- Current Photos & Management -->
      <div class="mb-4">
        <label class="form-label fw-semibold d-block">Current Photos (<%= images.length %>)</label>
        <% if (images && images.length > 0) { %>
          <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 g-3 mb-2">
            <% images.forEach((img, index) => { %>
              <div class="col">
                <div class="card h-100 border shadow-sm rounded-3 overflow-hidden">
                  <div class="position-relative" style="height: 110px;">
                    <img 
                      src="<%= img.url ? img.url.replace('/upload', '/upload/w_250') : '' %>" 
                      class="w-100 h-100" 
                      style="object-fit: cover;" 
                      alt="Listing photo <%= index + 1 %>"
                    >
                    <% if (index === 0) { %>
                      <span class="badge bg-danger position-absolute top-0 start-0 m-1" style="font-size: 0.65rem;">Cover</span>
                    <% } %>
                  </div>
                  <div class="card-body p-2 bg-light text-center">
                    <div class="form-check d-inline-block m-0">
                      <input 
                        class="form-check-input" 
                        type="checkbox" 
                        name="deleteImages[]" 
                        value="<%= img.filename %>" 
                        id="del-<%= index %>"
                      >
                      <label class="form-check-label text-danger small fw-semibold" for="del-<%= index %>">
                        Delete
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <small class="text-muted d-block">Check the box under any photo to remove it upon saving.</small>
        <% } else { %>
          <p class="text-muted small">No photos uploaded yet.</p>
        <% } %>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="newImages" class="form-label fw-semibold">Upload Additional Photos (optional)</label>
          <input id="newImages" name="listing[images]" type="file" class="form-control" multiple accept="image/*"/>
          <div class="form-text">You can select multiple photos to add to your gallery.</div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" class="form-select">
            <option value="trending" <%= listing.category === "trending" ? "selected" : "" %>>Trending</option>
            <option value="iconic" <%= listing.category === "iconic" ? "selected" : "" %>>Iconic Cities</option>
            <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
            <option value="castles" <%= listing.category === "castles" ? "selected" : "" %>>Castles</option>
            <option value="pools" <%= listing.category === "pools" ? "selected" : "" %>>Amazing Pools</option>
            <option value="camping" <%= listing.category === "camping" ? "selected" : "" %>>Camping</option>
            <option value="farms" <%= listing.category === "farms" ? "selected" : "" %>>Farms</option>
            <option value="arctic" <%= listing.category === "arctic" ? "selected" : "" %>>Arctic</option>
            <option value="jungle" <%= listing.category === "jungle" ? "selected" : "" %>>Jungle</option>
            <option value="beach" <%= listing.category === "beach" ? "selected" : "" %>>Beach</option>
          </select>
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-md-4">
          <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
          <input name="listing[price]" value="<%= listing.price %>" type="number" min="1" class="form-control" required />
          <div class="invalid-feedback">Price should be a valid number.</div>
        </div>

        <div class="mb-3 col-12 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required/>
          <div class="invalid-feedback">Country name is required.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location / City</label>
        <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required />
        <div class="invalid-feedback">Location is required.</div>
      </div>

      <!-- Amenities Checkboxes -->
      <div class="mb-4">
        <label class="form-label fw-semibold">Amenities Offered</label>
        <% 
           const currentAmenities = (listing.amenities && listing.amenities.length > 0) ? listing.amenities : [];
           const editAmenitiesList = [
             { id: "wifi", label: "WiFi", icon: "fa-solid fa-wifi" },
             { id: "pool", label: "Pool", icon: "fa-solid fa-person-swimming" },
             { id: "ac", label: "AC", icon: "fa-solid fa-snowflake" },
             { id: "parking", label: "Parking", icon: "fa-solid fa-square-parking" },
             { id: "kitchen", label: "Kitchen", icon: "fa-solid fa-kitchen-set" },
             { id: "tv", label: "TV", icon: "fa-solid fa-tv" },
             { id: "workspace", label: "Workspace", icon: "fa-solid fa-laptop" },
             { id: "pets", label: "Pet Friendly", icon: "fa-solid fa-paw" },
           ];
        %>
        <div class="row row-cols-2 row-cols-md-4 g-2">
          <% for(let item of editAmenitiesList) { %>
            <div class="col">
              <label class="amenity-checkbox-card" for="edit-<%= item.id %>">
                <input type="checkbox" id="edit-<%= item.id %>" name="listing[amenities][]" value="<%= item.id %>" <%= currentAmenities.includes(item.id) ? 'checked' : '' %>>
                <i class="<%= item.icon %>"></i>
                <span class="amenity-label"><%= item.label %></span>
              </label>
            </div>
          <% } %>
        </div>
      </div>

      <button class="btn btn-dark edit-btn mt-2 px-4 py-2">Update Listing</button>
    </form>
  </div>
</div>
