<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <h3 class="mb-4 fw-bold">Edit your Listing</h3>
    
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required/>
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>
      
      <div class="mb-3">
        <label class="form-label fw-semibold d-block">Current Listing Image</label>
        <img src="<%= originalImageUrl %>" class="img-thumbnail rounded shadow-sm" style="max-height: 200px; width: auto; object-fit: cover;" alt="<%= listing.title %>">
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="image" class="form-label fw-semibold">Upload New Image (optional)</label>
          <input name="listing[image][url]" type="file" class="form-control"/>
        </div>

        <div class="mb-3 col-md-6">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" class="form-select">
            <option value="trending" <%= listing.category === "trending" ? "selected" : "" %>>Trending</option>
            <option value="iconic" <%= listing.category === "iconic" ? "selected" : "" %>>Iconic Cities</option>
            <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
            <option value="castles" <%= listing.category === "castles" ? "selected" : "" %>>Castles</option>
            <option value="pools" <%= listing.category === "pools" ? "selected" : "" %>>Amazing Pools</option>
            <option value="camping" <%= listing.category === "camping" ? "selected" : "" %>>Camping</option>
            <option value="farms" <%= listing.category === "farms" ? "selected" : "" %>>Farms</option>
            <option value="arctic" <%= listing.category === "arctic" ? "selected" : "" %>>Arctic</option>
            <option value="jungle" <%= listing.category === "jungle" ? "selected" : "" %>>Jungle</option>
            <option value="beach" <%= listing.category === "beach" ? "selected" : "" %>>Beach</option>
          </select>
        </div>
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-md-4">
          <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
          <input name="listing[price]" value="<%= listing.price %>" type="number" min="1" class="form-control" required />
          <div class="invalid-feedback">Price should be a valid number.</div>
        </div>

        <div class="mb-3 col-12 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required/>
          <div class="invalid-feedback">Country name is required.</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location / City</label>
        <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required />
        <div class="invalid-feedback">Location is required.</div>
      </div>

      <button class="btn btn-dark edit-btn mt-3 px-4 py-2">Update Listing</button>
    </form>
  </div>
</div>
