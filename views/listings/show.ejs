<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = JSON.parse('<%- JSON.stringify(listing || {}) %>');
</script>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    
    <!-- Title -->
    <h2 class="mb-3 fw-bold"><%= listing.title %></h2>

    <!-- Listing Main Card -->
    <div class="card listing-card show-card mb-3">
      <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="<%= listing.title %>">
      
      <div class="card-body mt-2">
        <p class="card-text text-muted mb-2">
          Hosted by <b class="text-dark"><%= listing.owner ? listing.owner.username : "Host" %></b>
        </p> 
        <p class="card-text mb-2"><%= listing.description %></p> 
        <p class="card-text fs-5 fw-semibold mb-2">
          &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <span class="fs-6 fw-normal text-muted">/ night</span>
        </p>  
        <p class="card-text text-muted">
          <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
        </p> 
      </div>
    </div>

    <!-- Owner Action Buttons -->
    <% if(currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
      <div class="btns d-flex gap-3 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4">Edit</a>
        
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
          <button class="btn btn-outline-dark px-4" onclick="return confirm('Are you sure you want to delete this listing?');">Delete</button>
        </form>
      </div>
    <% } %>

    <hr class="my-4">

    <!-- Leave a Review Section -->
    <% if(currentUser) { %>
      <div class="mb-4">
        <h4 class="mb-3">Leave a Review</h4>
        
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mb-3">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Comment</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share your experience here..." required></textarea>
            <div class="invalid-feedback">Please write a comment before submitting.</div>
          </div>

          <button class="btn btn-dark px-4">Submit Review</button>
        </form>
      </div>
      <hr class="my-4">
    <% } %>

    <!-- All Reviews Section -->
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="mb-4">
        <h4 class="mb-3"><b>All Reviews (<%= listing.reviews.length %>)</b></h4>
        
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for(let review of listing.reviews) { %>
            <div class="col">
              <div class="card h-100 p-3 border shadow-sm">
                <div class="card-body p-0">
                  <div class="d-flex align-items-center mb-2">
                    <i class="fa-solid fa-circle-user fs-4 me-2 text-secondary"></i>
                    <h6 class="card-title m-0 fw-bold">@<%= review.author ? review.author.username : "guest" %></h6>
                  </div>
                  
                  <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="card-text text-secondary mb-3"><%= review.comment %></p>

                  <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <hr class="my-4">
    <% } %>

    <!-- Map Section -->
    <div class="mb-4">
      <h4 class="mb-2">Where you'll be</h4>
      <p class="text-muted"><i class="fa-solid fa-location-dot me-1"></i> <%= listing.location %>, <%= listing.country %></p>
      <div id="map"></div>
    </div>

  </div>
</div>

<script src="/js/map.js"></script>
