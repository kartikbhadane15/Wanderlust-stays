<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = JSON.parse('<%- JSON.stringify(listing || {}) %>');
</script>

<% 
   const isWishlisted = (currentUser && currentUser.wishlist) ? currentUser.wishlist.some(id => id.toString() === listing._id.toString()) : false;
   const isHost = (currentUser && listing.owner && listing.owner._id.equals(currentUser._id));
   const galleryImages = (listing.images && listing.images.length > 0) 
     ? listing.images 
     : (listing.image && listing.image.url ? [listing.image] : []);
%>

<div class="row mt-3 mb-5">
  
  <!-- Listing Header (Title, Location, Save Button) -->
  <div class="col-12 mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h2 class="fw-bold mb-1"><%= listing.title %></h2>
        <p class="text-muted mb-0">
          <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
          <% if (listing.category) { %>
            <span class="badge bg-light text-secondary border ms-2 text-capitalize">
              <%= listing.category %>
            </span>
          <% } %>
        </p>
      </div>

      <button 
        type="button" 
        id="showWishlistBtn"
        class="btn btn-outline-dark rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2 <%= isWishlisted ? 'border-danger text-danger' : '' %>" 
        data-listing-id="<%= listing._id %>"
      >
        <i class="<%= isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
        <span id="showWishlistText"><%= isWishlisted ? 'Saved' : 'Save' %></span>
      </button>
    </div>
  </div>

  <!-- Photo Showcase Section -->
  <div class="col-12 mb-4">
    <% if (galleryImages.length > 1) { %>
      
      <!-- Desktop Mosaic Grid (>= 768px) -->
      <div class="d-none d-md-block">
        <div class="gallery-mosaic <%= galleryImages.length === 2 ? 'gallery-2' : (galleryImages.length === 3 ? 'gallery-3' : (galleryImages.length === 4 ? 'gallery-4' : '')) %>">
          
          <!-- Hero Main Photo -->
          <div class="gallery-item gallery-hero" data-bs-toggle="modal" data-bs-target="#galleryModal" data-slide-to="0">
            <img src="<%= galleryImages[0].url %>" alt="<%= listing.title %> - Photo 1">
          </div>

          <!-- Secondary Photos -->
          <% for (let i = 1; i < Math.min(galleryImages.length, 5); i++) { %>
            <div class="gallery-item" data-bs-toggle="modal" data-bs-target="#galleryModal" data-slide-to="<%= i %>">
              <img src="<%= galleryImages[i].url %>" alt="<%= listing.title %> - Photo <%= i + 1 %>">
            </div>
          <% } %>

          <!-- Pill Button to open fullscreen gallery -->
          <button class="gallery-pill-btn" data-bs-toggle="modal" data-bs-target="#galleryModal">
            <i class="fa-solid fa-grip me-2"></i>Show all <%= galleryImages.length %> photos
          </button>
        </div>
      </div>

      <!-- Mobile Carousel (< 768px) -->
      <div class="d-md-none position-relative">
        <div id="mobileListingCarousel" class="carousel slide mobile-gallery-carousel" data-bs-ride="false">
          <div class="carousel-inner">
            <% galleryImages.forEach((img, idx) => { %>
              <div class="carousel-item <%= idx === 0 ? 'active' : '' %>" data-bs-toggle="modal" data-bs-target="#galleryModal" data-slide-to="<%= idx %>">
                <img src="<%= img.url %>" class="d-block w-100" alt="<%= listing.title %> - Photo <%= idx + 1 %>">
              </div>
            <% }); %>
          </div>

          <button class="carousel-control-prev" type="button" data-bs-target="#mobileListingCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#mobileListingCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>

          <!-- Slide counter badge -->
          <span class="carousel-counter-badge">
            <span id="mobileSlideNum">1</span> / <%= galleryImages.length %>
          </span>
        </div>
      </div>

    <% } else { %>
      <!-- Single Photo Layout -->
      <div class="card listing-card show-card mb-0">
        <img 
          src="<%= galleryImages[0] ? galleryImages[0].url : (listing.image ? listing.image.url : '') %>" 
          class="card-img-top show-img shadow-sm" 
          alt="<%= listing.title %>"
        >
      </div>
    <% } %>
  </div>

  <!-- Left Main Column: Info, Host, Reviews, Map -->
  <div class="col-12 col-lg-8">
    
    <div class="card listing-card show-card mb-3">
      <div class="card-body px-0 pt-0">
        <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
          <div>
            <h5 class="fw-bold mb-1">
              Entire rental unit hosted by <%= listing.owner ? listing.owner.username : "Host" %>
            </h5>
            <small class="text-muted d-block mb-2">Self check-in &bull; Free cancellation available</small>
            <% if (!isHost) { %>
              <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#contactHostModal">
                <i class="fa-regular fa-comment-dots me-1 text-danger"></i> Contact Host
              </button>
            <% } %>
          </div>
          <div class="avatar-circle" style="width: 50px; height: 50px; font-size: 1.3rem; background: #fe424d; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
            <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
          </div>
        </div>

        <h6 class="fw-bold mb-2">About this space</h6>
        <p class="card-text text-secondary mb-3" style="line-height: 1.6;"><%= listing.description %></p>

        <% if (listing.amenities && listing.amenities.length > 0) { %>
          <hr class="my-3">
          <h6 class="fw-bold mb-3">What this place offers</h6>
          <% 
             const amenityIcons = {
               wifi: { label: "Fast WiFi", icon: "fa-solid fa-wifi" },
               pool: { label: "Swimming Pool", icon: "fa-solid fa-person-swimming" },
               ac: { label: "Air conditioning", icon: "fa-solid fa-snowflake" },
               parking: { label: "Free parking on premises", icon: "fa-solid fa-square-parking" },
               kitchen: { label: "Kitchen", icon: "fa-solid fa-kitchen-set" },
               tv: { label: "TV", icon: "fa-solid fa-tv" },
               workspace: { label: "Dedicated workspace", icon: "fa-solid fa-laptop" },
               pets: { label: "Pet friendly", icon: "fa-solid fa-paw" },
             };
          %>
          <div class="amenities-grid mb-2">
            <% for (let a of listing.amenities) { %>
              <% if (amenityIcons[a]) { %>
                <div class="amenity-item">
                  <i class="<%= amenityIcons[a].icon %> text-danger"></i>
                  <span><%= amenityIcons[a].label %></span>
                </div>
              <% } %>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Host Action Buttons (Edit / Delete) -->
    <% if(isHost) { %>
      <div class="btns d-flex gap-2 mb-4 p-3 bg-light rounded-3 border">
        <span class="small text-muted me-auto d-flex align-items-center">
          <i class="fa-solid fa-gear me-1"></i> Host Controls
        </span>
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-dark edit-btn px-3">
          <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
        </a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
          <button class="btn btn-sm btn-outline-danger px-3">
            <i class="fa-solid fa-trash-can me-1"></i> Delete
          </button>
        </form>
      </div>
    <% } %>

    <hr class="my-4">

    <!-- Leave a Review Section -->
    <% if(currentUser) { %>
      <div class="mb-4">
        <h4 class="mb-3 fw-bold">Leave a Review</h4>
        
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
          <!-- Anti-spam honeypot -->
          <input type="text" name="_website_hp" class="honeypot-field" tabindex="-1" autocomplete="off">
          <div class="mb-3">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Comment</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control" placeholder="Share your experience here..." required></textarea>
            <div class="invalid-feedback">Please write a comment before submitting.</div>
          </div>

          <button class="btn btn-dark px-4">Submit Review</button>
        </form>
      </div>
      <hr class="my-4">
    <% } %>

    <!-- All Reviews Section -->
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="mb-4">
        <h4 class="mb-3 fw-bold">
          <i class="fa-solid fa-star text-danger me-1"></i>
          All Reviews (<%= listing.reviews.length %>)
        </h4>
        
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for(let review of listing.reviews) { %>
            <div class="col">
              <div class="card h-100 p-3 border shadow-sm rounded-3">
                <div class="card-body p-0">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center">
                      <i class="fa-solid fa-circle-user fs-4 me-2 text-secondary"></i>
                      <h6 class="card-title m-0 fw-bold">@<%= review.author ? review.author.username : "guest" %></h6>
                    </div>
                    <% if(currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete your review?');">
                        <button class="btn btn-sm text-danger p-0" title="Delete review">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                  
                  <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="card-text text-secondary mb-0"><%= review.comment %></p>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
      <hr class="my-4">
    <% } %>

    <!-- Map Section -->
    <div class="mb-4">
      <h4 class="mb-2 fw-bold">Where you'll be</h4>
      <p class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %></p>
      <div id="map" style="width: 100%; height: 350px; border-radius: 1rem;"></div>
    </div>

  </div>

  <!-- Right Column: Sticky Airbnb Reservation Card -->
  <div class="col-12 col-lg-4 mt-4 mt-lg-0">
    <div class="reservation-widget p-4 sticky-top" style="top: 85px; z-index: 10;">
      
      <!-- Price Header -->
      <div class="d-flex justify-content-between align-items-baseline mb-3">
        <div>
          <span class="fs-4 fw-bold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
          <span class="text-muted small"> / night</span>
        </div>
        <div>
          <small class="text-muted">
            <i class="fa-solid fa-star text-danger"></i>
            <%= (listing.reviews && listing.reviews.length > 0) ? `${listing.reviews.length} reviews` : 'New' %>
          </small>
        </div>
      </div>

      <% if (isHost) { %>
        <!-- Owner View Notice -->
        <div class="alert alert-light border rounded-3 p-3 text-center my-3">
          <i class="fa-solid fa-house-chimney-user fs-4 text-danger mb-2 d-block"></i>
          <h6 class="fw-bold mb-1">This is your property</h6>
          <p class="text-muted small mb-2">You can manage, edit details, or check reservations from your Host Dashboard.</p>
          <a href="/profile" class="btn btn-sm btn-outline-dark rounded-pill px-3">Go to Dashboard</a>
        </div>
      <% } else { %>
        <!-- Reservation Form -->
        <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm">
          
          <div class="booking-dates-box mb-3">
            <div class="row g-0">
              <div class="col-6 border-end p-2">
                <label for="checkInInput" class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">CHECK-IN</label>
                <input type="date" id="checkInInput" name="booking[checkIn]" class="form-control form-control-sm border-0 shadow-none p-0 fw-semibold" required>
              </div>
              <div class="col-6 p-2">
                <label for="checkOutInput" class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">CHECKOUT</label>
                <input type="date" id="checkOutInput" name="booking[checkOut]" class="form-control form-control-sm border-0 shadow-none p-0 fw-semibold" required>
              </div>
            </div>
            
            <div class="border-top p-2">
              <label for="guestsSelect" class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">GUESTS</label>
              <select id="guestsSelect" name="booking[guests]" class="form-select form-select-sm border-0 shadow-none p-0 fw-semibold">
                <option value="1" selected>1 guest</option>
                <option value="2">2 guests</option>
                <option value="3">3 guests</option>
                <option value="4">4 guests</option>
                <option value="5">5+ guests</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <input type="text" name="booking[specialRequests]" class="form-control form-control-sm rounded-2" placeholder="Special requests or note for host (optional)">
          </div>

          <!-- Reserve Button -->
          <% if (!currentUser) { %>
            <a href="/login" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 mb-2" style="background-color: #fe424d; border-color: #fe424d;">
              Log in to Reserve
            </a>
          <% } else { %>
            <button type="submit" id="reserveBtn" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 mb-2" style="background-color: #fe424d; border-color: #fe424d;">
              Reserve
            </button>
          <% } %>

          <p class="text-center text-muted small mb-3">You won't be charged yet</p>

          <div id="dateAlert" class="alert alert-warning py-1 px-2 small text-center d-none"></div>

          <!-- Live Price Breakdown -->
          <div id="bookingBreakdown" class="small pt-2 border-top">
            <div class="d-flex justify-content-between py-1 text-muted">
              <span id="breakdownNightsLabel">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> &times; <span id="nightsCount">1</span> night</span>
              <span id="breakdownBasePrice">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
            </div>
            <div class="d-flex justify-content-between py-1 text-muted">
              <span>GST &amp; Service Fee (18%)</span>
              <span id="breakdownGst">&#8377;<%= Math.round((listing.price || 0) * 0.18).toLocaleString("en-IN") %></span>
            </div>
            <hr class="my-2">
            <div class="d-flex justify-content-between py-1 fw-bold text-dark fs-6">
              <span>Total before taxes / Total</span>
              <span id="breakdownTotalPrice" class="text-danger">&#8377;<%= Math.round((listing.price || 0) * 1.18).toLocaleString("en-IN") %></span>
            </div>
          </div>

          <% if (!isHost) { %>
            <div class="text-center mt-3 pt-2 border-top">
              <button type="button" class="btn btn-link text-muted small p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#contactHostModal">
                <i class="fa-regular fa-comment-dots me-1 text-danger"></i> Have questions? Contact <%= listing.owner ? listing.owner.username : "Host" %>
              </button>
            </div>
          <% } %>

        </form>
      <% } %>

    </div>
  </div>

</div>

<!-- Fullscreen Gallery Lightbox Modal -->
<% if (galleryImages.length > 1) { %>
  <div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        
        <!-- Modal Header -->
        <div class="modal-header border-0 pb-0 pt-3 px-4">
          <div>
            <h5 class="modal-title fw-bold" id="galleryModalLabel"><%= listing.title %></h5>
            <small class="text-muted"><span id="modalActiveSlide">1</span> of <%= galleryImages.length %> photos</small>
          </div>
          <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Modal Body: Carousel -->
        <div class="modal-body p-3 p-md-4">
          <div id="modalGalleryCarousel" class="carousel slide" data-bs-ride="false">
            <div class="carousel-inner text-center">
              <% galleryImages.forEach((img, idx) => { %>
                <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                  <img src="<%= img.url %>" class="d-block gallery-modal-img" alt="<%= listing.title %> photo <%= idx + 1 %>">
                </div>
              <% }); %>
            </div>

            <!-- Controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#modalGalleryCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon p-3 bg-dark rounded-circle" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#modalGalleryCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon p-3 bg-dark rounded-circle" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>

          <!-- Bottom Thumbnail Navigation Strip -->
          <div class="gallery-thumb-strip mt-3 justify-content-center">
            <% galleryImages.forEach((img, idx) => { %>
              <img 
                src="<%= img.url ? img.url.replace('/upload', '/upload/w_150') : '' %>" 
                class="gallery-thumb <%= idx === 0 ? 'active' : '' %>" 
                alt="Thumbnail <%= idx + 1 %>"
                data-thumb-index="<%= idx %>"
              >
            <% }); %>
          </div>
        </div>

      </div>
    </div>
  </div>
<% } %>


<!-- Contact Host Modal -->
<div class="modal fade" id="contactHostModal" tabindex="-1" aria-labelledby="contactHostModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header px-4 py-3 border-bottom">
        <h5 class="modal-title fw-bold" id="contactHostModalLabel">
          <i class="fa-regular fa-paper-plane text-danger me-2"></i>Contact <%= listing.owner ? listing.owner.username : "Host" %>
        </h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <% if (!currentUser) { %>
        <div class="modal-body p-4 text-center">
          <div class="mb-3">
            <i class="fa-solid fa-lock text-muted" style="font-size: 3rem;"></i>
          </div>
          <h5 class="fw-bold mb-2">Login Required</h5>
          <p class="text-muted small mb-4">Please log in to Wanderlust to send a direct message to this host.</p>
          <a href="/login" class="btn btn-danger rounded-pill px-4 py-2">Log In to Message</a>
        </div>
      <% } else { %>
        <form action="/listings/<%= listing._id %>/contact" method="POST" id="contactHostForm">
          <!-- Anti-spam honeypot -->
          <input type="text" name="_website_hp" class="honeypot-field" tabindex="-1" autocomplete="off">
          <div class="modal-body p-4">
            
            <div class="d-flex align-items-center mb-3 p-2 bg-light rounded-3">
              <img src="<%= listing.image ? listing.image.url : "" %>" alt="<%= listing.title %>" class="rounded me-3" style="width: 52px; height: 52px; object-fit: cover;">
              <div class="overflow-hidden">
                <div class="fw-bold text-truncate small"><%= listing.title %></div>
                <div class="text-muted small"><%= listing.location %>, <%= listing.country %></div>
              </div>
            </div>

            <!-- Quick suggestion prompts -->
            <label class="form-label text-muted small fw-semibold mb-2">Quick questions</label>
            <div class="d-flex flex-wrap gap-1 mb-3">
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 quick-prompt-btn" data-prompt="Hi! Is early check-in or late checkout possible for our dates?">
                Early check-in?
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 quick-prompt-btn" data-prompt="Hello! Is the Wi-Fi fast enough for remote work and video meetings?">
                Fast Wi-Fi?
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-1 px-2 quick-prompt-btn" data-prompt="Hi! Is on-site secure parking available?">
                Parking available?
              </button>
            </div>

            <div class="mb-2">
              <label for="contactMessageText" class="form-label fw-semibold small">Your Message</label>
              <textarea 
                name="text" 
                id="contactMessageText" 
                rows="4" 
                class="form-control" 
                placeholder="Write your message or question to the host..." 
                required 
                maxlength="2000"
              ></textarea>
            </div>
            <small class="text-muted" style="font-size: 0.75rem;">Messages are saved to your Wanderlust Inbox.</small>
          </div>

          <div class="modal-footer px-4 py-3 border-top d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger rounded-pill px-4">
              <i class="fa-regular fa-paper-plane me-1"></i> Send Message
            </button>
          </div>
        </form>
      <% } %>

    </div>
  </div>
</div>

<script src="/js/map.js"></script>
<script>
  // Wishlist AJAX Toggle
  const showWishlistBtn = document.getElementById("showWishlistBtn");
  if (showWishlistBtn) {
    showWishlistBtn.addEventListener("click", async () => {
      const listingId = showWishlistBtn.getAttribute("data-listing-id");
      const icon = showWishlistBtn.querySelector("i");
      const text = document.getElementById("showWishlistText");

      try {
        const res = await fetch(`/listings/${listingId}/wishlist`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          }
        });

        if (res.status === 401) {
          window.location.href = "/login";
          return;
        }

        const data = await res.json();
        if (data.success) {
          if (data.isSaved) {
            icon.classList.remove("fa-regular");
            icon.classList.add("fa-solid", "text-danger");
            showWishlistBtn.classList.add("border-danger", "text-danger");
            text.textContent = "Saved";
          } else {
            icon.classList.remove("fa-solid", "text-danger");
            icon.classList.add("fa-regular");
            showWishlistBtn.classList.remove("border-danger", "text-danger");
            text.textContent = "Save";
          }

          const badge = document.getElementById("navWishlistBadge");
          if (badge) {
            badge.textContent = data.count;
            badge.classList.toggle("d-none", data.count === 0);
          }
        }
      } catch (err) {
        console.error("Wishlist error:", err);
      }
    });
  }

  // Interactive Live Booking Price Calculation
  const checkInInput = document.getElementById("checkInInput");
  const checkOutInput = document.getElementById("checkOutInput");
  const pricePerNight = <%= listing.price || 0 %>;
  const reserveBtn = document.getElementById("reserveBtn");
  const dateAlert = document.getElementById("dateAlert");

  const nightsCount = document.getElementById("nightsCount");
  const breakdownNightsLabel = document.getElementById("breakdownNightsLabel");
  const breakdownBasePrice = document.getElementById("breakdownBasePrice");
  const breakdownGst = document.getElementById("breakdownGst");
  const breakdownTotalPrice = document.getElementById("breakdownTotalPrice");

  if (checkInInput && checkOutInput) {
    const pad = (n) => n.toString().padStart(2, "0");
    const formatDate = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

    const today = new Date();
    const tomorrow = new Date();
    tomorrow.setDate(today.getDate() + 1);

    const dayAfter = new Date();
    dayAfter.setDate(today.getDate() + 3);

    checkInInput.min = formatDate(today);
    checkInInput.value = formatDate(tomorrow);

    checkOutInput.min = formatDate(tomorrow);
    checkOutInput.value = formatDate(dayAfter);

    function calculateBooking() {
      const inVal = checkInInput.value;
      const outVal = checkOutInput.value;

      if (!inVal || !outVal) return;

      const inDate = new Date(inVal);
      const outDate = new Date(outVal);
      const diffTime = outDate - inDate;
      const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

      if (nights <= 0) {
        if (reserveBtn) reserveBtn.disabled = true;
        if (dateAlert) {
          dateAlert.textContent = "Checkout must be after check-in date.";
          dateAlert.classList.remove("d-none");
        }
        return;
      }

      if (reserveBtn) reserveBtn.disabled = false;
      if (dateAlert) dateAlert.classList.add("d-none");

      const basePrice = pricePerNight * nights;
      const gst = Math.round(basePrice * 0.18);
      const total = basePrice + gst;

      if (nightsCount) nightsCount.textContent = nights;
      if (breakdownNightsLabel) {
        breakdownNightsLabel.innerHTML = `&#8377;${pricePerNight.toLocaleString("en-IN")} &times; ${nights} night${nights > 1 ? 's' : ''}`;
      }
      if (breakdownBasePrice) breakdownBasePrice.innerHTML = `&#8377;${basePrice.toLocaleString("en-IN")}`;
      if (breakdownGst) breakdownGst.innerHTML = `&#8377;${gst.toLocaleString("en-IN")}`;
      if (breakdownTotalPrice) breakdownTotalPrice.innerHTML = `&#8377;${total.toLocaleString("en-IN")}`;
    }

    checkInInput.addEventListener("change", () => {
      const selectedIn = new Date(checkInInput.value);
      const minOut = new Date(selectedIn);
      minOut.setDate(selectedIn.getDate() + 1);
      checkOutInput.min = formatDate(minOut);

      if (new Date(checkOutInput.value) <= selectedIn) {
        checkOutInput.value = formatDate(minOut);
      }
      calculateBooking();
    });

    checkOutInput.addEventListener("change", calculateBooking);

    // Initial calculation
    calculateBooking();
  }

  // Gallery Modal & Carousel Sync
  const modalCarouselEl = document.getElementById("modalGalleryCarousel");
  const modalActiveSlide = document.getElementById("modalActiveSlide");
  const thumbs = document.querySelectorAll(".gallery-thumb");

  if (modalCarouselEl) {
    const carouselInstance = bootstrap.Carousel.getOrCreateInstance(modalCarouselEl);

    // Open modal at specific slide when clicking mosaic items
    document.querySelectorAll("[data-slide-to]").forEach((item) => {
      item.addEventListener("click", () => {
        const slideIndex = parseInt(item.getAttribute("data-slide-to"), 10);
        carouselInstance.to(slideIndex);
      });
    });

    // Update thumbnail active state and slide counter on slide change
    modalCarouselEl.addEventListener("slid.bs.carousel", (e) => {
      const activeIdx = e.to;
      if (modalActiveSlide) {
        modalActiveSlide.textContent = activeIdx + 1;
      }
      thumbs.forEach((t, i) => {
        t.classList.toggle("active", i === activeIdx);
      });
    });

    // Thumbnail click jumps to slide
    thumbs.forEach((t) => {
      t.addEventListener("click", () => {
        const idx = parseInt(t.getAttribute("data-thumb-index"), 10);
        carouselInstance.to(idx);
      });
    });

    // Keyboard navigation (ArrowLeft & ArrowRight)
    document.addEventListener("keydown", (e) => {
      const modalEl = document.getElementById("galleryModal");
      if (modalEl && modalEl.classList.contains("show")) {
        if (e.key === "ArrowLeft") carouselInstance.prev();
        if (e.key === "ArrowRight") carouselInstance.next();
      }
    });
  }

  // Mobile Carousel slide counter
  const mobileCarouselEl = document.getElementById("mobileListingCarousel");
  const mobileSlideNum = document.getElementById("mobileSlideNum");
  if (mobileCarouselEl && mobileSlideNum) {
    mobileCarouselEl.addEventListener("slid.bs.carousel", (e) => {
      mobileSlideNum.textContent = e.to + 1;
    });
  }

  // Quick Prompt Chips for Contact Host Modal
  document.querySelectorAll(".quick-prompt-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const promptText = btn.getAttribute("data-prompt");
      const textarea = document.getElementById("contactMessageText");
      if (textarea && promptText) {
        textarea.value = promptText;
        textarea.focus();
      }
    });
  });
</script>
