<% layout("/layouts/boilerplate") %>

<div class="row mt-3 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <h3 class="mb-4 fw-bold">Create a New Listing</h3>
    
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" placeholder="e.g. Cozy Beachfront Villa" type="text" class="form-control" required />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please enter a title for your listing.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea
          name="listing[description]"
          class="form-control"
          rows="4"
          placeholder="Describe your place, amenities, and unique highlights..."
          required
        ></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-6">
          <label for="imageUpload" class="form-label fw-semibold">
            Upload Photos (up to 5 photos)
          </label>
          <input
            id="imageUpload"
            name="listing[images]"
            type="file"
            class="form-control"
            multiple
            accept="image/*"
            required
          />
          <div class="form-text">Choose up to 5 photos. The first image will be your main cover photo.</div>
          <div class="invalid-feedback">Please choose at least one image to upload.</div>
          
          <!-- Live Preview Container -->
          <div id="imagePreviewContainer" class="d-flex gap-2 flex-wrap mt-2"></div>
        </div>

        <div class="mb-3 col-md-6">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" class="form-select" required>
            <option value="" disabled selected>Select a category</option>
            <option value="trending">Trending</option>
            <option value="iconic">Iconic Cities</option>
            <option value="mountains">Mountains</option>
            <option value="castles">Castles</option>
            <option value="pools">Amazing Pools</option>
            <option value="camping">Camping</option>
            <option value="farms">Farms</option>
            <option value="arctic">Arctic</option>
            <option value="jungle">Jungle</option>
            <option value="beach">Beach</option>
          </select>
          <div class="invalid-feedback">Please select a category.</div>
        </div>
      </div>
      
      <div class="row">
        <div class="mb-3 col-12 col-md-4">
          <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
          <input name="listing[price]" placeholder="1200" type="number" min="1" class="form-control" required/>
          <div class="invalid-feedback">Price should be a valid positive number.</div>
        </div>
         
        <div class="mb-3 col-12 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" placeholder="e.g. India" type="text" class="form-control" required/>
          <div class="invalid-feedback">Country name is required.</div>
        </div>    
      </div>
       
      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location / City</label>
        <input
          name="listing[location]"
          placeholder="e.g. Jaipur, Rajasthan"
          type="text"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location is required.</div>
      </div>  

      <!-- Amenities Checkboxes -->
      <div class="mb-4">
        <label class="form-label fw-semibold">Amenities Offered</label>
        <div class="row row-cols-2 row-cols-md-4 g-2">
          <div class="col">
            <label class="amenity-checkbox-card" for="new-wifi">
              <input type="checkbox" id="new-wifi" name="listing[amenities][]" value="wifi">
              <i class="fa-solid fa-wifi"></i>
              <span class="amenity-label">WiFi</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-pool">
              <input type="checkbox" id="new-pool" name="listing[amenities][]" value="pool">
              <i class="fa-solid fa-person-swimming"></i>
              <span class="amenity-label">Pool</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-ac">
              <input type="checkbox" id="new-ac" name="listing[amenities][]" value="ac">
              <i class="fa-solid fa-snowflake"></i>
              <span class="amenity-label">AC</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-parking">
              <input type="checkbox" id="new-parking" name="listing[amenities][]" value="parking">
              <i class="fa-solid fa-square-parking"></i>
              <span class="amenity-label">Parking</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-kitchen">
              <input type="checkbox" id="new-kitchen" name="listing[amenities][]" value="kitchen">
              <i class="fa-solid fa-kitchen-set"></i>
              <span class="amenity-label">Kitchen</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-tv">
              <input type="checkbox" id="new-tv" name="listing[amenities][]" value="tv">
              <i class="fa-solid fa-tv"></i>
              <span class="amenity-label">TV</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-workspace">
              <input type="checkbox" id="new-workspace" name="listing[amenities][]" value="workspace">
              <i class="fa-solid fa-laptop"></i>
              <span class="amenity-label">Workspace</span>
            </label>
          </div>
          <div class="col">
            <label class="amenity-checkbox-card" for="new-pets">
              <input type="checkbox" id="new-pets" name="listing[amenities][]" value="pets">
              <i class="fa-solid fa-paw"></i>
              <span class="amenity-label">Pet Friendly</span>
            </label>
          </div>
        </div>
      </div>
          
      <button class="btn btn-dark add-btn mt-2 px-4 py-2">Add Listing</button>
    </form>
  </div>
</div>

<script>
  const imageUpload = document.getElementById("imageUpload");
  const previewContainer = document.getElementById("imagePreviewContainer");

  if (imageUpload && previewContainer) {
    imageUpload.addEventListener("change", function () {
      previewContainer.innerHTML = "";
      const files = Array.from(this.files).slice(0, 5);
      files.forEach((file, index) => {
        const reader = new FileReader();
        reader.onload = function (e) {
          const wrapper = document.createElement("div");
          wrapper.className = "position-relative";
          wrapper.style.width = "75px";
          wrapper.style.height = "55px";

          const img = document.createElement("img");
          img.src = e.target.result;
          img.className = "rounded border shadow-sm w-100 h-100";
          img.style.objectFit = "cover";

          if (index === 0) {
            const badge = document.createElement("span");
            badge.className = "badge bg-danger position-absolute top-0 start-0 m-1 p-1";
            badge.style.fontSize = "0.55rem";
            badge.textContent = "Cover";
            wrapper.appendChild(badge);
          }

          wrapper.appendChild(img);
          previewContainer.appendChild(wrapper);
        };
        reader.readAsDataURL(file);
      });
    });
  }
</script>
