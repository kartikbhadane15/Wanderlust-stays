<% if( success && success.length ) { %>
<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6">
    <div class="alert alert-success alert-dismissible fade show mt-3 d-flex align-items-center justify-content-between shadow-sm rounded-3 py-2 px-3 border-0" style="background-color: #e6f4ea; color: #137333;" role="alert">
      <div class="d-flex align-items-center me-2">
        <i class="fa-solid fa-circle-check fs-5 me-2"></i>
        <span class="fw-medium"><%= success %></span>
      </div>
      <button type="button" class="btn-close position-static p-2 m-0" data-bs-dismiss="alert" aria-label="Close" style="box-shadow: none;"></button>
    </div>
  </div>
</div>
<% } %>

<% if( error && error.length ) { %>
<div class="row justify-content-center">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6">
    <div class="alert alert-danger alert-dismissible fade show mt-3 d-flex align-items-center justify-content-between shadow-sm rounded-3 py-2 px-3 border-0" style="background-color: #fce8e6; color: #c5221f;" role="alert">
      <div class="d-flex align-items-center me-2">
        <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
        <span class="fw-medium"><%= error %></span>
      </div>
      <button type="button" class="btn-close position-static p-2 m-0" data-bs-dismiss="alert" aria-label="Close" style="box-shadow: none;"></button>
    </div>
  </div>
</div>
<% } %>
