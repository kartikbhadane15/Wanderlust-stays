<% if( success && success.length ) { %>
<div class="row">
  <div class="alert alert-success alert-dismissible fade show col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mt-3" role="alert">
    <%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>

<% if( error && error.length ) { %>
<div class="row">
  <div class="alert alert-danger alert-dismissible fade show col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mt-3" role="alert">
    <%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>
