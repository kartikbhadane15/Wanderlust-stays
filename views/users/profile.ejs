<% layout("/layouts/boilerplate") %>

<style>
  .profile-header-card {
    background: linear-gradient(135deg, #ffffff 0%, #f9f9f9 100%);
    border: 1px solid #eaeaea;
    border-radius: 1.25rem;
    padding: 2rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }

  .avatar-circle {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #fe424d 0%, #ff5a5f 100%);
    color: white;
    font-size: 2.2rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(254, 66, 77, 0.3);
  }

  .stat-badge {
    background-color: #f7f7f7;
    border: 1px solid #e8e8e8;
    border-radius: 1rem;
    padding: 0.85rem 1.15rem;
    text-align: center;
    min-width: 100px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .stat-badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.06);
  }

  .stat-badge .stat-num {
    font-size: 1.35rem;
    font-weight: 700;
    color: #222222;
    line-height: 1.2;
  }

  .stat-badge .stat-label {
    font-size: 0.75rem;
    color: #717171;
    font-weight: 500;
    margin: 0;
  }

  .dashboard-tabs .nav-link {
    color: #717171 !important;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    border-bottom: 2.5px solid transparent;
    padding: 0.75rem 1.25rem;
    border-radius: 0;
  }

  .dashboard-tabs .nav-link:hover {
    color: #222222 !important;
  }

  .dashboard-tabs .nav-link.active {
    color: #fe424d !important;
    background: transparent;
    border-bottom: 2.5px solid #fe424d;
  }

  .host-listing-card {
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .host-listing-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
  }
</style>

<div class="mt-4 mb-5">
  
  <!-- Top Profile Card -->
  <div class="profile-header-card mb-4">
    <div class="row align-items-center g-4">
      
      <!-- Avatar & Info -->
      <div class="col-12 col-md-5 d-flex align-items-center gap-3">
        <div class="avatar-circle flex-shrink-0">
          <%= user.username ? user.username.charAt(0).toUpperCase() : "U" %>
        </div>
        <div>
          <h2 class="fw-bold mb-1"><%= user.username %></h2>
          <p class="text-muted mb-1 fs-6">
            <i class="fa-regular fa-envelope me-1"></i> <%= user.email %>
          </p>
          <span class="badge bg-light text-secondary border px-2 py-1">
            <i class="fa-regular fa-calendar-check me-1 text-danger"></i> Member since <%= memberSince %>
          </span>
        </div>
      </div>

      <!-- Quick Stats -->
      <div class="col-12 col-md-7 d-flex justify-content-md-end justify-content-start gap-2 flex-wrap">
        <div class="stat-badge">
          <div class="stat-num text-danger"><%= myBookings ? myBookings.length : 0 %></div>
          <p class="stat-label">Trips</p>
        </div>
        <div class="stat-badge">
          <div class="stat-num"><%= myListings.length %></div>
          <p class="stat-label">Properties</p>
        </div>
        <div class="stat-badge">
          <div class="stat-num"><%= user.wishlist ? user.wishlist.length : 0 %></div>
          <p class="stat-label">Wishlist</p>
        </div>
        <div class="stat-badge">
          <div class="stat-num"><%= myReviews.length %></div>
          <p class="stat-label">Reviews</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Dashboard Navigation Tabs -->
  <ul class="nav dashboard-tabs border-bottom mb-4" id="dashboardTab" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="trips-tab" data-bs-toggle="tab" data-bs-target="#trips-pane" type="button" role="tab">
        <i class="fa-solid fa-suitcase-rolling me-1"></i> My Trips (<%= myBookings ? myBookings.length : 0 %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="host-tab" data-bs-toggle="tab" data-bs-target="#host-pane" type="button" role="tab">
        <i class="fa-solid fa-house-user me-1"></i> My Properties (<%= myListings.length %>)
      </button>
    </li>
    <% if (hostBookings && hostBookings.length > 0) { %>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="host-bookings-tab" data-bs-toggle="tab" data-bs-target="#host-bookings-pane" type="button" role="tab">
          <i class="fa-solid fa-calendar-days me-1"></i> Guest Reservations (<%= hostBookings.length %>)
        </button>
      </li>
    <% } %>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews-pane" type="button" role="tab">
        <i class="fa-solid fa-star me-1"></i> Reviews Written (<%= myReviews.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="wishlist-tab" data-bs-toggle="tab" data-bs-target="#wishlist-pane" type="button" role="tab">
        <i class="fa-solid fa-heart me-1"></i> Saved Stays (<%= user.wishlist ? user.wishlist.length : 0 %>)
      </button>
    </li>
  </ul>

  <!-- Tab Content Panes -->
  <div class="tab-content" id="dashboardTabContent">
    
    <!-- Tab 1: My Trips (Reservations) -->
    <div class="tab-pane fade show active" id="trips-pane" role="tabpanel">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">My Booked Trips</h4>
        <a href="/listings" class="btn btn-dark add-btn rounded-pill px-3 py-2">
          <i class="fa-solid fa-magnifying-glass me-1"></i> Explore More Stays
        </a>
      </div>

      <% if (!myBookings || myBookings.length === 0) { %>
        <div class="text-center py-5 my-4 border rounded-4 bg-light">
          <i class="fa-solid fa-plane-departure display-4 text-muted mb-3"></i>
          <h4 class="fw-bold">No trips booked yet</h4>
          <p class="text-muted" style="max-width: 400px; margin: 0 auto;">
            When you're ready to plan your next getaway, your reservations and trip receipts will appear right here.
          </p>
          <a href="/listings" class="btn btn-dark add-btn mt-3 px-4 py-2">Start Exploring</a>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% for(let booking of myBookings) { %>
            <div class="col">
              <div class="card h-100 host-listing-card border shadow-sm">
                <% if (booking.listing) { %>
                  <a href="/bookings/<%= booking._id %>">
                    <img src="<%= booking.listing.image ? booking.listing.image.url : '' %>" class="card-img-top" alt="<%= booking.listing.title %>" style="height: 12rem; object-fit: cover;">
                  </a>
                <% } %>
                
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge font-monospace <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-danger' %>">
                      <%= booking.status.toUpperCase() %>
                    </span>
                    <small class="text-muted font-monospace"><%= booking.bookingCode %></small>
                  </div>

                  <h6 class="fw-bold text-truncate mb-1">
                    <%= booking.listing ? booking.listing.title : 'Stay' %>
                  </h6>
                  <p class="text-muted small mb-2">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                    <%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : 'Location' %>
                  </p>

                  <div class="bg-light p-2 rounded-2 mb-3 small">
                    <div class="fw-semibold">
                      <i class="fa-regular fa-calendar-check me-1 text-primary"></i>
                      <%= new Date(booking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
                      &ndash;
                      <%= new Date(booking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
                    </div>
                    <div class="text-muted">
                      <%= booking.totalNights %> night<%= booking.totalNights > 1 ? 's' : '' %> &bull; <%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="small text-muted">Total Paid</span>
                    <span class="fw-bold fs-6">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                  </div>

                  <div class="mt-3 d-flex gap-2">
                    <a href="/bookings/<%= booking._id %>" class="btn btn-sm btn-dark flex-grow-1">
                      View Receipt
                    </a>
                    <% if (booking.status === 'confirmed') { %>
                      <form method="POST" action="/bookings/<%= booking._id %>/cancel" onsubmit="return confirm('Cancel this reservation?');">
                        <button class="btn btn-sm btn-outline-danger" title="Cancel Reservation">
                          <i class="fa-solid fa-ban"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Tab 2: Host Dashboard (My Properties) -->
    <div class="tab-pane fade" id="host-pane" role="tabpanel">
      <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">Managed Properties</h4>
        <a href="/listings/new" class="btn btn-dark add-btn rounded-pill px-3 py-2">
          <i class="fa-solid fa-plus me-1"></i> Add New Listing
        </a>
      </div>

      <% if (myListings.length === 0) { %>
        <div class="text-center py-5 my-4 border rounded-4 bg-light">
          <i class="fa-solid fa-hotel display-4 text-muted mb-3"></i>
          <h4 class="fw-bold">No properties listed yet</h4>
          <p class="text-muted" style="max-width: 400px; margin: 0 auto;">
            Become a host on Wanderlust! Share your space and start welcoming travelers from around the world.
          </p>
          <a href="/listings/new" class="btn btn-dark add-btn mt-3 px-4 py-2">List your home</a>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% for(let listing of myListings) { %>
            <div class="col">
              <div class="card h-100 host-listing-card border shadow-sm">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                  <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 13rem; object-fit: cover;">
                </a>
                
                <div class="card-body p-3">
                  <h6 class="fw-bold text-truncate mb-1"><%= listing.title %></h6>
                  <p class="text-muted small mb-2">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
                  </p>
                  
                  <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> <span class="text-muted small">/ night</span></span>
                    <span class="badge bg-light text-secondary border">
                      <i class="fa-solid fa-comment me-1"></i> <%= listing.reviews.length %> reviews
                    </span>
                  </div>

                  <!-- Manage Actions -->
                  <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-dark flex-grow-1">
                      <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                    </a>
                    <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-secondary">
                      <i class="fa-solid fa-eye"></i>
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing permanently?');">
                      <button class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Tab 3: Guest Bookings (for Hosts) -->
    <% if (hostBookings && hostBookings.length > 0) { %>
      <div class="tab-pane fade" id="host-bookings-pane" role="tabpanel">
        <h4 class="fw-bold mb-3">Guest Reservations on Your Stays</h4>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% for(let booking of hostBookings) { %>
            <div class="col">
              <div class="card h-100 host-listing-card border shadow-sm">
                <div class="card-body p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge font-monospace <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-danger' %>">
                      <%= booking.status.toUpperCase() %>
                    </span>
                    <small class="text-muted font-monospace"><%= booking.bookingCode %></small>
                  </div>

                  <h6 class="fw-bold mb-1 text-truncate">
                    <a href="/bookings/<%= booking._id %>" class="text-dark text-decoration-none">
                      <%= booking.listing ? booking.listing.title : 'Stay' %>
                    </a>
                  </h6>

                  <p class="small text-muted mb-2">
                    Guest: <b>@<%= booking.user ? booking.user.username : 'guest' %></b>
                  </p>

                  <div class="bg-light p-2 rounded-2 mb-2 small">
                    <div class="fw-semibold">
                      <%= new Date(booking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
                      &ndash;
                      <%= new Date(booking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric" }) %>
                    </div>
                    <div class="text-muted">
                      <%= booking.totalNights %> nights &bull; <%= booking.guests %> guests
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <span class="small text-muted">Host Payout</span>
                    <span class="fw-bold text-success">&#8377; <%= booking.basePrice.toLocaleString("en-IN") %></span>
                  </div>

                  <div class="mt-3">
                    <a href="/bookings/<%= booking._id %>" class="btn btn-sm btn-outline-dark w-100">
                      View Details
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Tab 4: Reviews Written -->
    <div class="tab-pane fade" id="reviews-pane" role="tabpanel">
      <h4 class="fw-bold mb-3">Reviews You've Written</h4>

      <% if (myReviews.length === 0) { %>
        <div class="text-center py-5 my-4 border rounded-4 bg-light">
          <i class="fa-regular fa-comment-dots display-4 text-muted mb-3"></i>
          <h4 class="fw-bold">No reviews written yet</h4>
          <p class="text-muted">
            Share your experiences by leaving reviews on stays you've visited!
          </p>
          <a href="/listings" class="btn btn-outline-dark px-4 py-2 mt-2">Explore stays</a>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for(let item of myReviews) { %>
            <div class="col">
              <div class="card h-100 p-3 border rounded-3 shadow-sm">
                <div class="card-body p-0">
                  
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <% if(item.listing) { %>
                        <h6 class="fw-bold mb-0">
                          <a href="/listings/<%= item.listing._id %>" class="text-decoration-none text-dark">
                            <i class="fa-solid fa-hotel me-1 text-danger"></i> <%= item.listing.title %>
                          </a>
                        </h6>
                        <small class="text-muted"><%= item.listing.location %>, <%= item.listing.country %></small>
                      <% } else { %>
                        <h6 class="fw-bold mb-0 text-muted">Stay (Listing deleted)</h6>
                      <% } %>
                    </div>

                    <% if(item.listing) { %>
                      <form method="POST" action="/listings/<%= item.listing._id %>/reviews/<%= item.review._id %>?_method=DELETE" onsubmit="return confirm('Delete this review?');">
                        <button class="btn btn-sm text-danger p-0" title="Delete review">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>

                  <p class="starability-result card-text mb-2" data-rating="<%= item.review.rating %>"></p>
                  <p class="card-text text-secondary mb-0"><%= item.review.comment %></p>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Tab 5: Wishlist Quick Access -->
    <div class="tab-pane fade" id="wishlist-pane" role="tabpanel">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="fw-bold mb-0">Saved Stays</h4>
        <a href="/wishlist" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          View Full Wishlist <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
      </div>

      <% if (!user.wishlist || user.wishlist.length === 0) { %>
        <div class="text-center py-5 my-4 border rounded-4 bg-light">
          <i class="fa-regular fa-heart display-4 text-muted mb-3"></i>
          <h4 class="fw-bold">Your wishlist is empty</h4>
          <p class="text-muted">Save your favorite stays by tapping the heart icon on any listing.</p>
          <a href="/listings" class="btn btn-dark add-btn mt-2 px-4 py-2">Start exploring</a>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
          <% for(let listing of user.wishlist) { %>
            <div class="col">
              <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card h-100 listing-card">
                  <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 12rem; object-fit: cover;">
                  <div class="card-body p-2">
                    <b class="d-block text-truncate"><%= listing.title %></b>
                    <small class="text-muted"><%= listing.location %>, <%= listing.country %></small>
                    <div class="fw-semibold mt-1">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night</div>
                  </div>
                </div>
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

  </div>
</div>
